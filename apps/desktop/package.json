{
  "name": "@maris/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Maris Windows desktop shell",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/package-desktop.mjs",
    "stage:python-resources": "node scripts/stage-python-resources.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "generate:api": "node scripts/generate-api.mjs",
    "check:generated": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "2.0.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.4.5",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
