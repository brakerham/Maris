{
  "name": "@wife-system/openclaw-finance-probe",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw bridge to the wife-system phase-0 finance probe.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "dependencies": {
    "typebox": "1.3.17"
  },
  "peerDependencies": {
    "openclaw": "2026.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "openclaw": "2026.8.2",
    "typescript": "^5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.8.2",
      "minGatewayVersion": "2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    }
  }
}
